{
  "name": "lazarus-1-2-3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:diff": "vitest run tests/differential",
    "check:manifest": "vitest run tests/unit/fixtures/manifest.test.ts tests/unit/fixtures/gen-fixtures.test.ts",
    "check:opcodes": "vitest run tests/unit/formula/opcode-coverage.test.ts tests/unit/formula/opcodes.test.ts",
    "check:pii": "vitest run tests/unit/fixtures/pii.test.ts",
    "oracle": "bun scripts/oracle.ts",
    "oracle:mcp": "bun mcp/lotus-oracle/server.ts",
    "lazarus": "bun src/cli/lazarus.ts",
    "verify:golden": "bun scripts/verify-golden.ts",
    "gen:fixtures": "bun scripts/gen-fixtures.ts",
    "docker:test": "docker build --target test -t lazarus-1-2-3:test . && docker run --rm lazarus-1-2-3:test",
    "docker:e2e": "docker build --target e2e -t lazarus-1-2-3:e2e . && docker run --rm --ipc=host lazarus-1-2-3:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "exceljs": "4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
